import Mathlib.Topology.Algebra.Group.Basic
import Mathlib.Topology.Algebra.Semigroup
import Lean.Elab.Tactic.Omega

/-!
# Compact subsemigroups of a Hausdorff topological group

This uses Mathlib's compact-semigroup idempotent theorem. It adds no
random-matrix assumption. Draft: actual compilation is deferred.
-/

noncomputable section
namespace FixedCouplingPoisson
open Set

section Group
variable {G : Type*} [Group G] [TopologicalSpace G] [T2Space G]
    [IsTopologicalGroup G]

/-- A nonempty compact multiplication-closed subset of a group contains the
identity, because its compact-semigroup idempotent must be the identity. -/
theorem one_mem_of_compact_mul_closed {C : Set G} (hC : IsCompact C)
    (hne : C.Nonempty) (hmul : ∀ x ∈ C, ∀ y ∈ C, x * y ∈ C) : 1 ∈ C := by
  obtain ⟨y, hy, hidem⟩ := exists_idempotent_in_compact_subsemigroup
    (fun r => continuous_id.mul continuous_const) C hne hC hmul
  have hyone : y = 1 := by
    apply mul_left_cancel (a := y)
    simpa only [mul_one] using hidem
  simpa only [hyone] using hy

/-- The strictly positive powers, viewed as an actual subsemigroup. -/
def positivePowerSubsemigroup (x : G) : Subsemigroup G where
  carrier := range (fun n : ℕ => x ^ (n + 1))
  mul_mem' := by
    rintro _ _ ⟨m, rfl⟩ ⟨n, rfl⟩
    refine ⟨m + n + 1, ?_⟩
    change x ^ ((m + n + 1) + 1) = x ^ (m + 1) * x ^ (n + 1)
    rw [show (m + n + 1) + 1 = (m + 1) + (n + 1) by omega, pow_add]

/-- Every element of a compact submonoid has its inverse in that submonoid.
Compactness of the ambient group is not required. -/
theorem inverse_mem_of_compact_submonoid (S : Submonoid G)
    (hS : IsCompact (S : Set G)) {x : G} (hx : x ∈ S) : x⁻¹ ∈ S := by
  let P := positivePowerSubsemigroup x
  have hPS : (P : Set G) ⊆ S := by
    rintro _ ⟨n, rfl⟩
    exact S.pow_mem hx _
  have hKS : closure (P : Set G) ⊆ S := closure_minimal hPS hS.isClosed
  have hK : IsCompact (closure (P : Set G)) :=
    hS.of_isClosed_subset isClosed_closure hKS
  have hPne : (P : Set G).Nonempty := ⟨x, ⟨0, by simp⟩⟩
  have hKne : (closure (P : Set G)).Nonempty := hPne.mono subset_closure
  have hKmul : ∀ a ∈ closure (P : Set G), ∀ b ∈ closure (P : Set G),
      a * b ∈ closure (P : Set G) := by
    intro a ha b hb
    exact P.topologicalClosure.mul_mem ha hb
  have h1K : (1 : G) ∈ closure (P : Set G) :=
    one_mem_of_compact_mul_closed hK hKne hKmul
  have hpre : IsClosed {y : G | x⁻¹ * y ∈ S} :=
    hS.isClosed.preimage (continuous_const.mul continuous_id)
  have hPpre : (P : Set G) ⊆ {y : G | x⁻¹ * y ∈ S} := by
    rintro _ ⟨n, rfl⟩
    change x⁻¹ * x ^ (n + 1) ∈ S
    rw [pow_succ']
    simpa only [← mul_assoc, inv_mul_cancel, one_mul] using S.pow_mem hx n
  have h := closure_minimal hPpre hpre h1K
  simpa only [Set.mem_setOf_eq, mul_one] using h

/-- A compact submonoid, with no change to its carrier, is a subgroup. -/
def subgroupOfCompactSubmonoid (S : Submonoid G)
    (hS : IsCompact (S : Set G)) : Subgroup G where
  carrier := S
  one_mem' := S.one_mem
  mul_mem' := S.mul_mem
  inv_mem' := inverse_mem_of_compact_submonoid S hS

@[simp] theorem subgroupOfCompactSubmonoid_coe (S : Submonoid G)
    (hS : IsCompact (S : Set G)) :
    (subgroupOfCompactSubmonoid S hS : Set G) = S := rfl

/-- Thus a compact topological closure of a generated monoid contains
the entire subgroup generated by its original generators. -/
theorem subgroupClosure_le_compactSubmonoid {A : Set G} (S : Submonoid G)
    (hS : IsCompact (S : Set G)) (hA : A ⊆ S) :
    (Subgroup.closure A : Set G) ⊆ S := by
  change Subgroup.closure A ≤ subgroupOfCompactSubmonoid S hS
  exact (Subgroup.closure_le (subgroupOfCompactSubmonoid S hS)).mpr hA

end Group
end FixedCouplingPoisson
